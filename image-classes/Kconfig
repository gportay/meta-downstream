menu "Image Classes"

config HAS_IMAGE_CLASSES_GRUB_EFI_CFG
	bool "Class grub-efi-cfg"
	depends on HAS_MACHINE_FEATURES_EFI
	help
	  Provide grub-efi specific functions for building bootable
	  images.

	  https://github.com/openembedded/openembedded-core/tree/master/meta/classes-recipe/grub-efi-cfg.bbclass

config KAS_INCLUDE_HAS_IMAGE_CLASSES_GRUB_EFI_CFG
	string
	depends on HAS_IMAGE_CLASSES_GRUB_EFI_CFG
	default "image-classes/grub-efi-cfg.yaml"

config HAS_IMAGE_CLASSES_QEMUBOOT
	bool "Class qemuboot"
	help
	  Help runqemu boot target board.

	  https://github.com/openembedded/openembedded-core/tree/master/meta/classes-recipe/qemuboot.bbclass

config KAS_INCLUDE_HAS_IMAGE_CLASSES_QEMUBOOT
	string
	depends on HAS_IMAGE_CLASSES_QEMUBOOT
	default "image-classes/qemuboot.yaml"

