config HAS_IMAGE_CLASSES_SYSTEMD_BOOT_CFG
	bool "Class systemd-boot-cfg"
	depends on HAS_MACHINE_FEATURES_EFI
	help
	  Provide systemd-boot specific functions for building bootable
	  images.

	  https://github.com/openembedded/openembedded-core/tree/master/meta/classes-recipe/systemd-boot-cfg.bbclass

