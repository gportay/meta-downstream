# short-description: Create an EFI disk image with custom bootloader config and separate hash dm-verity
# long-description: Creates a partitioned EFI disk image that the user
# can directly dd to boot media. The bootloader configuration source is a
# generated user file. We need to fetch the partition images from the
# IMGDEPLOYDIR as the rootfs source plugin will not recreate the exact block
# device corresponding with the hash tree. We must not alter the label or any
# other setting on the image.
# Based on meta-security's systemd-bootdisk-dmverity-hash.wks.in file
#
# This .wks only works with the dm-verity-img class and separate hash data. (DM_VERITY_SEPARATE_HASH)

part /boot --source bootimg-efi --sourceparams="loader=${EFI_PROVIDER}" --ondisk sda --label msdos --active --align 1024 --use-uuid

# include the root+hash part with the dynamic hash/UUIDs from the build.
include ${STAGING_VERITY_DIR}/${IMAGE_BASENAME}.${DM_VERITY_IMAGE_TYPE}.wks.in

# add "console=ttyS0,115200" or whatever you need to the --append="..."
bootloader --ptable gpt --timeout=5 --append="root=/dev/mapper/rootfs" --configfile="${EFI_CFG}"

part swap --ondisk sda --size 44 --label swap1 --fstype=swap --use-uuid
